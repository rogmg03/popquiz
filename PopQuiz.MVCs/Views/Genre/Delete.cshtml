@model PopQuiz.MVCs.Models.ViewModels.GenreViewModels

@{
    ViewData["Title"] = "Eliminar género";
}
<style>
    input, select, textarea {
        color: black !important;
    }
</style>

<link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />

<div class="movies-shell">

    <!-- Header / Hero -->
    <section class="movies-hero container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="eyebrow-label">PopQuiz Genres</span>
                <h1 class="page-title text-danger">Eliminar género</h1>
                <p class="page-subtitle">
                    Esta acción es permanente. Confirmá si deseas eliminar el género seleccionado.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Genre" asp-action="Index" class="btn btn-secondary btn-lg">
                    ← Volver al catálogo
                </a>
            </div>
        </div>
    </section>

    <!-- Card de confirmación -->
    <section class="container mt-4">
        <div class="movie-form-card shadow-lg p-4">

            <h3 class="fw-bold text-danger mb-4">¿Seguro que deseas eliminar este género?</h3>

            <div class="mb-4">
                <dl class="row">
                    <dt class="col-sm-3 fw-bold">ID</dt>
                    <dd class="col-sm-9">@Model.GenreId</dd>

                    <dt class="col-sm-3 fw-bold">Nombre</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                </dl>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="GenreId" />

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-danger btn-lg w-50">
                        🗑 Eliminar definitivamente
                    </button>

                    <a asp-action="Index" class="btn btn-secondary btn-lg w-50">
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
