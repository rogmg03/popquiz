@model PopQuiz.MVCs.Models.ViewModels.GenreViewModels

@{
    ViewData["Title"] = "Editar género";
}

<style>
    input, select, textarea {
        color: black !important;
    }
</style>

<link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />

<div class="movies-shell">

    <!-- Header / Hero -->
    <section class="movies-hero container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="eyebrow-label">PopQuiz Genres</span>
                <h1 class="page-title">Editar género</h1>
                <p class="page-subtitle">
                    Modificá los datos del género seleccionado.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Genre" asp-action="Index" class="btn btn-secondary btn-lg">
                    ← Volver al listado
                </a>
            </div>
        </div>
    </section>

    <!-- Formulario -->
    <section class="container mt-4">
        <div class="movie-form-card shadow-lg">

            <form asp-action="Edit">
                <input type="hidden" asp-for="GenreId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Nombre del género -->
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control form-control-lg" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Botón -->
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        Guardar cambios
                    </button>
                </div>

            </form>

        </div>
    </section>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
