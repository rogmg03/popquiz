@{

    ViewData["Title"] = "Iniciar sesión";

}

<div class="auth-page">
    <div class="container auth-container">
        <div class="row align-items-center g-4">
            <!-- Columna izquierda (texto de valor) -->
            <div class="col-lg-6 d-none d-lg-block">
                <div class="auth-highlight">
                    <span class="eyebrow-label">PopQuiz Movies</span>
                    <h1 class="auth-title">Todo tu catálogo de películas en un solo lugar.</h1>
                    <p class="auth-text">

                        Gestioná títulos, directores y géneros conectando este sitio MVC con tus

                        APIs internas. Diseñado para crecer como una solución corporativa de

                        consulta y administración de películas.
                    </p>
                    <ul class="auth-bullets">
                        <li>Buscador rápido por título, director, género o año de estreno.</li>
                        <li>Interfaz lista para integrarse con servicios REST de la solución.</li>
                    </ul>
                </div>
            </div>

            <!-- Columna derecha (formulario) -->
            <div class="col-lg-6">
                <div class="auth-card">
                    <div class="auth-card-header text-center">
                        <div class="auth-logo-circle">
                            <span class="auth-logo-icon">🎬</span>
                        </div>
                        <h2 class="auth-card-title">Iniciar sesión</h2>
                        <p class="auth-card-subtitle">

                            Accedé con tus credenciales para administrar el catálogo de películas.
                        </p>
                    </div>

                    <div class="auth-card-body">
                        <form asp-controller="Login"
                              asp-action="Index"
                              method="post"
                              class="auth-form needs-validation"
                              novalidate>
                            <div class="mb-3">
                                <label for="Input_Email" class="form-label">Correo electrónico</label>
                                <input type="email"
                                       class="form-control form-control-lg auth-input"
                                       id="Input_Email"
                                       name="Email"
                                       placeholder="tu.correo@empresa.com"
                                       required />
                                <div class="invalid-feedback">

                                    Ingresá un correo electrónico válido.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="Input_Password" class="form-label">Contraseña</label>
                                <div class="password-field">
                                    <input type="password"
                                           class="form-control form-control-lg auth-input"
                                           id="Input_Password"
                                           name="Password"
                                           placeholder="••••••••"
                                           required />
                                    <button type="button"
                                            class="btn btn-link btn-sm password-toggle"
                                            aria-label="Mostrar u ocultar contraseña">

                                        Mostrar
                                    </button>
                                </div>
                                <div class="invalid-feedback">

                                    La contraseña es obligatoria.
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="RememberMe"
                                           name="RememberMe" />
                                    <label class="form-check-label" for="RememberMe">

                                        Mantener sesión iniciada
                                    </label>
                                </div>
                                <a href="#" class="auth-link">¿Olvidaste tu contraseña?</a>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 auth-submit-btn">

                                Entrar al panel
                            </button>
                        </form>

                        <p class="auth-secondary-text text-center mt-4">

                            ¿Nuevo en la plataforma?
                            <a href="#" class="auth-link">Solicitá tu acceso</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>

        (function () {

            'use strict';

            // Marcamos el body para aplicar estilos específicos de login

            document.body.classList.remove('movies-page');

            document.body.classList.add('login-page');

            // Validación básica de formulario (Bootstrap-like)

            var form = document.querySelector('.auth-form');

            if (form) {

                form.addEventListener('submit', function (event) {

                    if (!form.checkValidity()) {

                        event.preventDefault();

                        event.stopPropagation();

                    }

                    form.classList.add('was-validated');

                }, false);

            }

            // Mostrar / ocultar contraseña

            var toggle = document.querySelector('.password-toggle');

            var passwordInput = document.getElementById('Input_Password');

            if (toggle && passwordInput) {

                toggle.addEventListener('click', function () {

                    var isPassword = passwordInput.getAttribute('type') === 'password';

                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                    this.textContent = isPassword ? 'Ocultar' : 'Mostrar';

                });

            }

        })();
    </script>

}

